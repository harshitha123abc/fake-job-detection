{
  "manifest_version": 3,
  "name": "Fake Job Detector",
  "version": "1.0",
  "description": "Detect fake job postings using AI-powered analysis",
  "permissions": [
    "activeTab",
    "storage",
    "http://localhost:5000/*",
    "https://your-deployed-api.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check Job Posting"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}